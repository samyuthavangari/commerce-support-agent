# ════════════════════════════════════════════════════════════
#  Commerce Support AI Agent — Environment Configuration
#  Copy this file:  cp .env.example .env
#  Then fill in your actual keys below.
# ════════════════════════════════════════════════════════════

# ── Google Gemini API Key ────────────────────────────────────────────────
GOOGLE_API_KEY=your_api_key_here

# ── Qdrant (local-first; cloud optional) ───────────────────────────────────
# Default path for reviewers: run local Qdrant with Docker and leave the
# two lines below commented out.
#   docker run -d -p 6333:6333 qdrant/qdrant
# Then build the index once:  python src/qdrant_store.py --build
#
# Cloud alternative (free tier at https://cloud.qdrant.io) — uncomment + fill:
# QDRANT_URL=https://your-cluster-url.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# ── Kaggle (optional – only if re-downloading twcs.csv via Kaggle API) ────
# Download kaggle.json from https://www.kaggle.com/settings → API
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# ── Agent Model Settings ──────────────────────────────────────────────────
CLASSIFIER_MODEL=gemini-3.1-flash-lite
DRAFTER_MODEL=gemini-3.1-flash-lite
JUDGE_MODEL=gemini-3.1-flash-lite

# ── Retrieval Settings ────────────────────────────────────────────────────
TOP_K_RETRIEVAL=5
MAX_SAMPLE_THREADS=10000
